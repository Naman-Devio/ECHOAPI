# ══════════════════════════════════════════════════════════════════════════════
# EchoTube API — Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and edit as needed:
#   cp .env.example .env

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8000
WORKERS=1
HOST=0.0.0.0

# ── Redis Cache ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600
MAX_MEM_CACHE_SIZE=1000

# ── Proxy Settings ───────────────────────────────────────────────────────────
USE_PROXIES=true
ENABLE_PROXY_CHECKER=false
PROXY_TYPE=any

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT=120

# ── YouTube ──────────────────────────────────────────────────────────────────
COOKIES_FILE=

# ── PO Token Provider ────────────────────────────────────────────────────────
# Required for audio-only streams. Without it, only 360p combined format available.
# Docker: docker run -d -p 4416:4416 brainicism/bgutil-ytdlp-pot-provider
POT_PROVIDER_URL=http://127.0.0.1:4416

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
