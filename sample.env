# ══════════════════════════════════════════════════════════════════════════════
# EchoTube API — Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and edit as needed:
#   cp .env.example .env

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8000
WORKERS=1
HOST=0.0.0.0

# ── Redis Cache ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600
MAX_MEM_CACHE_SIZE=1000

# ── Proxy Settings ───────────────────────────────────────────────────────────
USE_PROXIES=false
ENABLE_PROXY_CHECKER=false
PROXY_TYPE=any

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT=120

# ── YouTube ──────────────────────────────────────────────────────────────────
COOKIES_FILE=

# ── PO Token Provider ────────────────────────────────────────────────────────
# Co-located bgutil PO Token Provider (Node.js/Deno) for cloud & local execution
POT_PROVIDER_URL=http://127.0.0.1:4416
POT_SERVER_URL=http://127.0.0.1:4416

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
